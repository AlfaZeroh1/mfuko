# Mfuko POS — nginx server block (PHP-FPM)
server {
    listen 80;
    server_name pos.example.co.ke;
    root /var/www/mfuko-pos;
    index index.php;
    client_max_body_size 10m;

    location ~ ^/(app|config|sql|storage|tools)/ { deny all; }
    location ~ /\.(env|git|ht) { deny all; }
    location ~ ^/uploads/.*\.(php|phtml|phar)$ { deny all; }
    location ~* \.(css|js|svg|png|webp|jpg|woff2)$ { expires 30d; access_log off; }

    location ~ \.php$ {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_pass unix:/run/php/php8.2-fpm.sock;
    }
}
